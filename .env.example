# AI (Phase 4). AI_PROVIDER = gemini | mock | off.
# Unset: gemini when GEMINI_API_KEY is set; otherwise mock in development, off in production.
AI_PROVIDER=
# Server-only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Model ids (default: gemini-flash-latest for both).
AI_MODEL_FAST=
AI_MODEL_SMART=
# Abuse and cost protection.
AI_REQUESTS_PER_10_MIN=30
AI_REQUESTS_PER_DAY=150
# Global kill switch: total AI requests per UTC day for this server (0 = AI off).
AI_DAILY_BUDGET=2000

# PDF rendering. Optional: path to a Chrome/Chromium binary for local development.
CHROME_EXECUTABLE_PATH=

# Abuse protection: PDF downloads per minute per IP (burst = 2x).
RATE_LIMIT_PDF_PER_MINUTE=10
