{
  "name": "ai-cv-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-aicv \"node scripts/rules-test.mjs\"",
    "verify": "npm run lint && npm run typecheck && npm run format:check && npm run test && npm run build",
    "qa:templates": "tsx scripts/render-fixtures.tsx artifacts/visual/templates",
    "fonts:sync": "tsx scripts/sync-fonts.ts",
    "templates:thumbs": "tsx scripts/template-thumbnails.tsx",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "ai:eval": "tsx --conditions=react-server scripts/ai-eval.ts",
    "emulators": "firebase emulators:start --only auth --project demo-aicv"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "clsx": "^2.1.1",
    "docx": "^9.15.3",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.71.0",
    "mammoth": "^1.13.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "puppeteer-core": "^25.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/word-extractor": "^1.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "firebase-tools": "^15.35.0",
    "jszip": "^3.10.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
