rules_version = '2';

// AI CV Studio — Firestore security rules.
//
// Every read and write of the studio's data is made by the server with the Admin SDK, which is not
// subject to these rules. Browsers never talk to Firestore directly, so no client access is
// allowed to any studio collection — not even to a signed-in person's own documents.
//
// Published to the project's (default) database on 2026-11-13 (owner decision: this site is the
// only product in the project). They replaced the old Flutter app's rules, which allowed browsers
// to write to `users` and `paymentRequests`. Tested by scripts/rules-test.mjs in the Firestore
// emulator (CI).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{path=**} { allow read, write: if false; }
    match /documents/{path=**} { allow read, write: if false; }
    match /versions/{path=**} { allow read, write: if false; }
    match /jobs/{path=**} { allow read, write: if false; }
    match /usage/{path=**} { allow read, write: if false; }
    match /passes/{path=**} { allow read, write: if false; }
    match /paymentRequests/{path=**} { allow read, write: if false; }
    match /config/{path=**} { allow read, write: if false; }
    match /adminAudit/{path=**} { allow read, write: if false; }
    match /metrics/{path=**} { allow read, write: if false; }
    match /shares/{path=**} { allow read, write: if false; }
    match /portfolios/{path=**} { allow read, write: if false; }
    match /referralCodes/{path=**} { allow read, write: if false; }

    // Everything else in the project, including the old app's collections.
    match /{path=**} { allow read, write: if false; }
  }
}
